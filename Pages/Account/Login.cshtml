@page
@model RememberMe.Pages.Account.LoginModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var GoogleEnabled = !string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientId"])
                     && !string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientSecret"]);
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in";
}
<div class="auth-card">
    <div class="brand" style="justify-content:center; margin-bottom:6px;">
        <div class="candle"><div class="flame-glow"></div><div class="flame"></div><div class="wax"></div></div>
        <div class="brand-word">Remember Me</div>
    </div>
    <div class="tagline">never miss a moment worth celebrating</div>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label>Username</label>
            <input asp-for="Username" type="text" placeholder="e.g. thandi_m" autocomplete="username" />
        </div>
        <div class="field">
            <label>Password</label>
            <div class="password-wrap">
                <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password" title="Show password">
                    <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </div>
        <div class="error-msg">@Model.ErrorMessage</div>
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>
    @if (GoogleEnabled)
    {
        <div class="auth-divider"><span>or</span></div>
        <form method="post" asp-page="/Account/ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl">
            <button type="submit" class="btn btn-google btn-block">Continue with Google</button>
        </form>
    }
    <div class="link-swap">New here? <a href="/Account/Register?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Create an account</a></div>
</div>

<script>
    (function () {
        var input = document.getElementById('Password');
        var btn = document.getElementById('pw-toggle');
        if (!input || !btn) return;

        btn.addEventListener('click', function () {
            var showing = input.type === 'text';
            input.type = showing ? 'password' : 'text';
            btn.querySelector('.icon-eye').style.display = showing ? '' : 'none';
            btn.querySelector('.icon-eye-off').style.display = showing ? 'none' : '';
            btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
            btn.title = showing ? 'Show password' : 'Hide password';
        });
    })();
</script>