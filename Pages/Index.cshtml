@page
@model RememberMe.Pages.IndexModel
@{
    ViewData["Active"] = "home";
    ViewData["Title"] = "Dashboard";
}

<h2 id="hello-name" style="margin:0 0 16px;">Hi there 🎈</h2>

<div class="card" style="padding:16px 18px; margin-bottom:20px;">
    <div class="card-eyebrow" style="margin-bottom:8px;">Got a code from someone?</div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <input type="text" id="redeem-code-input" class="inline-input" style="flex:1; min-width:180px;" placeholder="Paste their share link or code">
        <button class="btn btn-secondary btn-sm" id="redeem-code-btn">Add it</button>
    </div>
</div>

<div class="dash-grid">
    <div>
        <div class="card" id="next-occasion-card">
            <div class="card-icon-badge">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2v6M8 22h8M6 22c0-5 1-6 6-6s6 1 6 6M4 10c1.5 1.5 3.5 1.5 4-.5.5 2 2.5 2 3-.5.5 2 2.5 2 3-.5.5 2 2.5 2 4 .5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="card-eyebrow">Coming up next</div>
            <div class="next-name" id="next-name">—</div>
            <div class="next-date" id="next-date">Loading…</div>
            <div id="next-countdown"></div>
        </div>
        <div class="card">
            <div class="card-eyebrow">Total installments · everyone</div>
            <div id="installments-summary"><div class="empty-note">Loading…</div></div>

            <div class="section-title" style="font-size:13px; margin-top:16px;">By person</div>
            <div id="installments-carousel"></div>
        </div>

        <div class="card">
            <div class="card-eyebrow">Reminder settings</div>
            <div class="empty-note" style="text-align:left; padding-left:0;">You'll always get a reminder the day before an occasion.</div>
            <div class="toggle-switch-row">
                <span>Also remind me 3 days before</span>
                <label class="switch"><input type="checkbox" id="notify-3-toggle"><span class="switch-track"></span></label>
            </div>
            <div class="toggle-switch-row">
                <span>Also remind me 7 days before</span>
                <label class="switch"><input type="checkbox" id="notify-7-toggle"><span class="switch-track"></span></label>
            </div>
        </div>
    </div>
    <div>
        <div class="section-title">Everything you're tracking</div>
        <div id="people-list"><div class="empty-note">Loading…</div></div>
    </div>
</div>
